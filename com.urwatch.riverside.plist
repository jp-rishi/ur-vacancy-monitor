<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.urwatch.riverside</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>/Users/isshin/workspace/develop/ur-vacancy-monitor/ur_watch.py</string>
    </array>

    <!-- Re-check every 15 minutes (900 seconds). -->
    <key>StartInterval</key>
    <integer>900</integer>

    <!-- Also run once immediately when loaded / at login. -->
    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/isshin/workspace/develop/ur-vacancy-monitor</string>

    <key>StandardOutPath</key>
    <string>/Users/isshin/workspace/develop/ur-vacancy-monitor/run.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/isshin/workspace/develop/ur-vacancy-monitor/run.log</string>
</dict>
</plist>
